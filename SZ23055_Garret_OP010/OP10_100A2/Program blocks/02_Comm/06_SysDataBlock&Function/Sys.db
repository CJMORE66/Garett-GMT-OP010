DATA_BLOCK "Sys"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   STRUCT 
      COM : Struct
         AlwaysOFF : Bool;
         AlwaysON : Bool;
         FlashTime100mS : Bool;
         FlashTime200mS : Bool;
         FlashTime500mS : Bool;
         FlashTime1S : Bool;
         FlashTime2S : Bool;
         SpareBit : Bool;
         PLCRestarted : Bool;
      END_STRUCT;
      SpareB1 : Array[0..7] of Byte;
      DateTime : Struct
         Set : Date_And_Time;
         Read : Date_And_Time;
         Trigger : Bool;
         ReturnValueRead : Int;
         ReturnValueSet : Int;
      END_STRUCT;
      SpareB2 : Array[0..17] of Byte;
      ScanTime : Struct
         CyclePrevious : Int;
         CycleMax : Int;
         CycleMin : Int;
      END_STRUCT;
      RETVALI : Int;
      RETVALW : Word;
      VersionManagement : Struct
         ProductLineName : String;
         ProjectNumber : String[20];
         "PLC IP Addr" : Array[0..3] of UInt;
         "HMI IP Addr" : Array[0..3] of UInt;
         PLCVersion : Array[0..1] of UInt;
         HMIVersion : Array[0..1] of UInt;
         "TIA Version" : String;
         StationID : Int;
         HMIPageID : Int;
      END_STRUCT;
   END_STRUCT;


BEGIN
   COM.AlwaysOFF := FALSE;
   COM.AlwaysON := TRUE;
   COM.FlashTime100mS := TRUE;
   COM.FlashTime200mS := TRUE;
   COM.FlashTime500mS := FALSE;
   COM.FlashTime1S := FALSE;
   COM.FlashTime2S := TRUE;
   COM.SpareBit := FALSE;
   COM.PLCRestarted := TRUE;
   SpareB1[0] := 16#00;
   SpareB1[1] := 16#00;
   SpareB1[2] := 16#00;
   SpareB1[3] := 16#00;
   SpareB1[4] := 16#00;
   SpareB1[5] := 16#00;
   SpareB1[6] := 16#00;
   SpareB1[7] := 16#00;
   DateTime.Set := DT#1990-01-01-00:00:00;
   DateTime.Read := DT#2025-03-12-08:03:05.785;
   DateTime.Trigger := FALSE;
   DateTime.ReturnValueRead := 0;
   DateTime.ReturnValueSet := 0;
   SpareB2[0] := 16#00;
   SpareB2[1] := 16#00;
   SpareB2[2] := 16#00;
   SpareB2[3] := 16#00;
   SpareB2[4] := 16#00;
   SpareB2[5] := 16#00;
   SpareB2[6] := 16#00;
   SpareB2[7] := 16#00;
   SpareB2[8] := 16#00;
   SpareB2[9] := 16#00;
   SpareB2[10] := 16#00;
   SpareB2[11] := 16#00;
   SpareB2[12] := 16#00;
   SpareB2[13] := 16#00;
   SpareB2[14] := 16#00;
   SpareB2[15] := 16#00;
   SpareB2[16] := 16#00;
   SpareB2[17] := 16#00;
   ScanTime.CyclePrevious := 14;
   ScanTime.CycleMax := 23;
   ScanTime.CycleMin := 9;
   RETVALI := 0;
   RETVALW := 16#0000;
   VersionManagement.ProductLineName := 'Assembly Line';
   VersionManagement.ProjectNumber := 'SZ23055';
   VersionManagement."PLC IP Addr"[0] := 192;
   VersionManagement."PLC IP Addr"[1] := 168;
   VersionManagement."PLC IP Addr"[2] := 10;
   VersionManagement."PLC IP Addr"[3] := 10;
   VersionManagement."HMI IP Addr"[0] := 192;
   VersionManagement."HMI IP Addr"[1] := 168;
   VersionManagement."HMI IP Addr"[2] := 45;
   VersionManagement."HMI IP Addr"[3] := 11;
   VersionManagement.PLCVersion[0] := 1;
   VersionManagement.PLCVersion[1] := 0;
   VersionManagement.HMIVersion[0] := 1;
   VersionManagement.HMIVersion[1] := 0;
   VersionManagement."TIA Version" := 'TIA V18';
   VersionManagement.StationID := 10;
   VersionManagement.HMIPageID := 0;

END_DATA_BLOCK

