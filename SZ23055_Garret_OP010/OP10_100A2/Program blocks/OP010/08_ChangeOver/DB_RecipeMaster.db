DATA_BLOCK "DB_RecipeMaster"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// ATTRIBUTES
// AUTO_NUMBER = False
// BLOCK_NUMBER = 2700
// END_ATTRIBUTES
   VAR 
      Header : "UDT_RecipeHeader";
