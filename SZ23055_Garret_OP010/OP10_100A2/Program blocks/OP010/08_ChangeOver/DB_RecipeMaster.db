   FixtureCodes[7] := 'SZ23055-OP010-E-Compressor-ring1 Loading tooling-7';
   FixtureCodes[8] := 'SZ23055-OP010-E-Compressor-ring1 Loading tooling-8';
   FixtureCodes[9] := 'SZ23055-OP010-E-Compressor-ring2 Loading tooling-1';
   FixtureCodes[10] := 'SZ23055-OP010-E-Compressor-ring2 Loading tooling-2';
