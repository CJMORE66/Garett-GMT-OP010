      FixtureCodes : Array[1..16] of String[128];
      GripperCodes : Array[1..18] of String[128];
      VisionPrograms : Array[1..16] of Int;
   END_VAR


BEGIN
   Header.ProductName := 'Product_1';
   Header.ProductID := 'P1';
   Header.RecipeVersion := 'V1.0';
   Header.FixtureFamily := 1;
   Header.Enabled := TRUE;
   Header.CreatedBy := 'OP10';
   Header.UpdatedBy := 'OP10';
   Header.Comment := 'Seed recipe migrated from ST10_RecipeDB';

   FixtureCodes[1] := 'SZ23055-OP010-E-Compressor-ring1 Loading tooling-1';
   FixtureCodes[2] := 'SZ23055-OP010-E-Compressor-ring1 Loading tooling-2';
   FixtureCodes[3] := 'SZ23055-OP010-E-Compressor-ring1 Loading tooling-3';
