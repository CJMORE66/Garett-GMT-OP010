DATA_BLOCK "DB_RecipeActiveNew"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// ATTRIBUTES
// AUTO_NUMBER = False
// BLOCK_NUMBER = 2701
// END_ATTRIBUTES
   VAR 
      Header : "UDT_RecipeHeader";
      SubProcess : Array[1..16] of "UDT_SubProcessRecipe";
      FixtureCodes : Array[1..16] of String[128];
      GripperCodes : Array[1..12] of String[128];
      PressPrograms : Array[1..4] of Int;
      VisionPrograms : Array[1..8] of Int;
   END_VAR


BEGIN
   Header.ProductName := 'ACTIVE';
   Header.ProductID := 'ACTIVE';
   Header.RecipeVersion := 'PENDING';
   Header.Enabled := FALSE;

END_DATA_BLOCK

