DATA_BLOCK "Station_Sys"
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : RCS
FAMILY : Sys
VERSION : 2.0
// ATTRIBUTES
// AUTO_NUMBER = False
// BLOCK_NUMBER = 1060
// END_ATTRIBUTES
   STRUCT 
      ScreenNo : Int;   // For change HMI screen
      SpareB01 : Array[0..7] of Byte;   // *******************************************************************************
      Status { S7_SetPoint := 'False'} : "RCS_SysStatus_V1";   // DBX10.0
      Input : Struct   // DBX20.0 For change PLC I input to PLC inside bit
         OP1 : Struct
            "Function 1" : Bool;
            "Function 2" : Bool;
            "Function 3" : Bool;
            "Function 4" : Bool;
            "Function 5" : Bool;
            "Function 6" : Bool;
            "Function 7" : Bool;
            "Function 8" : Bool;
         END_STRUCT;
         OP2 : Struct
            "Function 1" : Bool;
            "Function 2" : Bool;
            "Function 3" : Bool;
         END_STRUCT;
         OP3 : Struct
            "Function 1" : Bool;
            "Function 2" : Bool;
            "Function 3" : Bool;
         END_STRUCT;
      END_STRUCT;
      SpareB02 : Array[0..13] of Byte;   // *******************************************************************************
      HMI : Struct
         AP : Struct
            S1 : Int;
            CurrentScreenID : Int;
            S3 : Int;
            S4 : Int;
            S5 : Int;
         END_STRUCT;
      END_STRUCT;
      Cmd { S7_SetPoint := 'False'} : "RCS_SysCmd_V1";   // DBX50.0
      SpareB03 : Array[0..7] of Byte;   // *******************************************************************************
      Interface { S7_SetPoint := 'False'} : "RCS_SysComInterface_V1";
      SpareB04 : Array[0..3] of Byte;   // *******************************************************************************
      Initial : Struct
         Set : Bool;
         Running : Bool;
         OK : Bool;
      END_STRUCT;
      SpareB05 : Array[0..27] of Byte;   // *******************************************************************************
      Auto { S7_SetPoint := 'False'} : "RCS_SysAuto_V1";   // DBX100.0
      SpareB10 : Array[0..5] of Byte;   // *******************************************************************************
      A : Struct
         "Device1 Auto control" : Bool;
         "Device2 Auto control" : Bool;
         "Device3 Auto control" : Bool;
         "Device4 Auto control" : Bool;
         "Device 01" : Struct
            "Function 1" : Bool;
            "Function 2" : Bool;
            "Function 3" : Bool;
         END_STRUCT;
         "Device 02" : Struct
            "Function 1" : Bool;
            "Function 2" : Bool;
            "Function 3" : Bool;
         END_STRUCT;
      END_STRUCT;
      SpareB11 : Array[0..33] of Byte;   // *******************************************************************************
      Manual { S7_SetPoint := 'False'} : "RCS_SysManual_V1";   // DBX150.0
      SpareB12 : Array[0..6] of Byte;   // *******************************************************************************
      M : Struct
         "Device1 Manual control" : Bool;
         "Device2 Manual control" : Bool;
         "Device3 Manual control" : Bool;
         "Device4 Manual control" : Bool;
      END_STRUCT;
      SpareB13 : Array[0..37] of Byte;   // *******************************************************************************
      Safety { S7_SetPoint := 'False'} : "RCS_SysSafety_V1";   // DBX200.0
      SpareB20 : Array[0..9] of Byte;   // *******************************************************************************
      Signal : Struct   // DBX220.0
         MainPressureSwitch1 : Bool;
         MainPressureSwitch2 : Bool;
         MainPressureSwitch3 : Bool;
      END_STRUCT;
      SpareB21 : Array[0..36] of Byte;   // *******************************************************************************
      Flag : Struct   // DBX260.0
         Processstart : Bool;
         PeocessComplete : Bool;
         IndexTable : Struct
            Interlock : Bool;
            TableRunning : Bool;
            StopandPosition : Bool;
            PositionOK : Bool;
            PositionNG : Bool;
            FixtureOK : Bool;
            FixtureNG : Bool;
            InitialOK : Bool;
         END_STRUCT;
      END_STRUCT;
      SpareB22 : Array[0..5] of Byte;   // *******************************************************************************
      P : Struct   // Positive RLO Edge Detection:-(P)- DBX270
         Record : Bool;
         "Set index run" : Bool;
         initial : Array[0..7] of Bool;
      END_STRUCT;
      SpareB23 : Array[0..5] of Byte;   // *******************************************************************************
      N : Struct   // Negative RLO Edge Detection:-(N)- DBX280
         Spare : Bool;
      END_STRUCT;
      SpareB24 : Array[0..17] of Byte;   // *******************************************************************************
      Alarm { S7_SetPoint := 'False'} : "RCS_SysAlarmWarning_V1";   // DBX300.0
      SpareB30 : Array[0..7] of Byte;   // *******************************************************************************
      Warning { S7_SetPoint := 'False'} : "RCS_SysAlarmWarning_V1";   // DBX500.0
      SpareB31 : Array[0..7] of Byte;   // *******************************************************************************
      AlarmTimes : Struct   // If a fault continue happened over Limit_times，Auto running will be stopped
         ForceStop : Bool;   // DBX650.0
         Reset : Bool;
         Limit : Int;
      END_STRUCT;
      SpareB33 : Array[0..5] of Byte;   // *******************************************************************************
      AlarmWarning : Int;   // DBX660 1:Alarm 2:Warning
      SpareB34 : Array[0..17] of Byte;   // *******************************************************************************
      Count { S7_SetPoint := 'False'} : "RCS_SysCount_V1";   // DBX700.0
      SpareB40 : Array[0..11] of Byte;   // *******************************************************************************
      TotalCycleTime { S7_SetPoint := 'False'} : "RCS_SysCycleTime_V1";   // DBX850.0
      SpareB41 : Array[0..11] of Byte;   // *******************************************************************************
      MachineCycleTime { S7_SetPoint := 'False'} : "RCS_SysCycleTime_V1";   // DBX950.0
      SpareB42 : Array[0..11] of Byte;   // *******************************************************************************
      UserName { S7_SetPoint := 'True'} : String[20];
   END_STRUCT;


BEGIN
   Cmd.OnOffLine := TRUE;

END_DATA_BLOCK

