DATA_BLOCK "GluingControl"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
// ATTRIBUTES
// AUTO_NUMBER = False
// BLOCK_NUMBER = 2800
// END_ATTRIBUTES
   STRUCT 
      Input : Struct
         GluingDeviceReady : Bool;
         GluingFault : Bool;
         GluingRefillTank : Bool;
         GluingTankEmpty : Bool;
      END_STRUCT;
      Output : Struct
         GluingPro_X : Bool;
         GluingPro_Y : Bool;
         GluingPro_Z : Bool;
         GluingReset : Bool;
      END_STRUCT;
      Control : Struct
         Manual_X : Bool;
         Manual_Y : Bool;
         Manual_Z : Bool;
         Manual_Control : Int;
         Auto_Start : Bool;
         Auto_Y : Bool;
         Auto_Z : Bool;
         Auto_Control : Int;
         ManualTest_X : Bool;
         ManualTestStartGlue : Bool;
      END_STRUCT;
      GlueCalibratonMode : Bool;
      TON {InstructionName := 'IEC_LTIMER'; LibVersion := '1.0'; S7_SetPoint := 'False'} : Array[1..10] of IEC_LTIMER;
      P { S7_SetPoint := 'True'} : Array[1..10] of Bool;
      GlueInitiaStart : Bool;
   END_STRUCT;


BEGIN

END_DATA_BLOCK

