DATA_BLOCK "DB_ProcessSlots"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// ATTRIBUTES
// AUTO_NUMBER = False
// BLOCK_NUMBER = 2600
// END_ATTRIBUTES
   VAR 
      Slots : Array[1..16] of "UDT_ProcessSlot";
