TYPE "UDT_StaProcessData"
VERSION : 0.1
   STRUCT
      TypeName : String[50];
      PartID : String[48];
      PalletNo : Int;
      Mode : Int;
      "P-SubPartID" : Array[1..10] of String[48];
      Count_Total : DInt;
      Count_OK : DInt;
      Count_NG : DInt;
      CycleTime : Real;
      PartResult : Int;
   END_STRUCT;

END_TYPE

