TYPE "UDT_SubProcessRecipe"
VERSION : 0.1
   STRUCT
      Name : String[32];
      TargetValue : Real;
      TolerancePlus : Real;
      ToleranceMinus : Real;
      Unit : String[8];
      MesNgCode : String[9];
      Enabled : Bool;
      RecipeGroup : Int;
      ProgramNumber : Int;
      Spare : Array[1..8] of Real;
   END_STRUCT;

END_TYPE

