TYPE "UDT_ProcessSlot"
VERSION : 0.1
   STRUCT
      SlotID : Int;
      PositionTag : String[24];
      ProductID : String[48];
      PartSerial : String[64];
      DMC : String[128];
      ExpectedFixture : String[128];
      ActualFixture : String[128];
      ExpectedGripper : String[128];
      ActualGripper : String[128];
      RecipeLink : Int;
      PartStatus : Int;
      Result : Int;
      NGCode : String[9];
      LastUpdateTS : Date_And_Time;
      Measurements : "UDT_ProcessMeasurements";
   END_STRUCT;

END_TYPE

