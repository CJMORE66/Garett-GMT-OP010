TYPE "HMI_Axis"
VERSION : 0.1
   STRUCT
      INPUT : Struct
         Axis_ID : Int := 1;
         Speed : Int;
         SimplyTrigger : Bool;
         ListTrigger : Bool;
         ListPosID : Int;
         SimplyPos : Real;
         Enable : Bool;
         "Jog+" : Bool;
         "Jog-" : Bool;
         Homing : Bool;
         Stop : Bool;
      END_STRUCT;
      OUTPUT : Struct
         Ready : Bool;
         Alarm : Bool;
         Warming : Bool;
         RunEnd : Bool;
         Interference : Bool;
         "Reference Point" : Bool;
         CurrentPosition : Real;
         CurrentSpeed : Real;
         TargetPosition : Real;
         Enable : Bool;
         MAX_Axis : Int := 1;
      END_STRUCT;
   END_STRUCT;

END_TYPE

