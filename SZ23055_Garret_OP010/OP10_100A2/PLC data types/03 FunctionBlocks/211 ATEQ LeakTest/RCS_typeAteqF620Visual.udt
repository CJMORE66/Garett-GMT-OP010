TYPE "RCS_typeAteqF620Visual"
VERSION : 0.1
   STRUCT
      Trigger : Struct
         SetProg : Bool;
         Measure : Bool;
      END_STRUCT;
      Set : Struct
         ProgNo : UInt;
      END_STRUCT;
      Status { ExternalWritable := 'False'} : Struct
         InstanceName { ExternalWritable := 'False'} : WString[20];
         DeviceReady { ExternalWritable := 'False'} : Bool;
         Ready { ExternalWritable := 'False'} : Bool;
         Error { ExternalWritable := 'False'} : Bool;
         SetProgOk { ExternalWritable := 'False'} : Bool;
         MeasureOk { ExternalWritable := 'False'} : Bool;
         ErrorCode { ExternalWritable := 'False'} : UInt;
         Result { ExternalWritable := 'False'} : Struct
            PassPart { ExternalWritable := 'False'} : Bool;
            FailTestPart { ExternalWritable := 'False'} : Bool;
            FailRefPart { ExternalWritable := 'False'} : Bool;
            Alarm { ExternalWritable := 'False'} : Bool;
            PressureError { ExternalWritable := 'False'} : Bool;
            PartRecoverable { ExternalWritable := 'False'} : Bool;
            CalibError { ExternalWritable := 'False'} : Bool;
            CalibCheckError { ExternalWritable := 'False'} : Bool;
            AtrFault { ExternalWritable := 'False'} : Bool;
            Leak { ExternalWritable := 'False'} : Struct
               Value { ExternalWritable := 'False'} : Real;
               Unit { ExternalWritable := 'False'} : String[10];
            END_STRUCT;
         END_STRUCT;
         Pressure { ExternalWritable := 'False'} : Struct
            Value { ExternalWritable := 'False'} : Real;
            Unit { ExternalWritable := 'False'} : String[10];
         END_STRUCT;
         ActProgStep { ExternalWritable := 'False'} : UInt;
         ActProgNo { ExternalWritable := 'False'} : UInt;
         ElapsedTime { ExternalWritable := 'False'} : Time;
      END_STRUCT;
   END_STRUCT;

END_TYPE

