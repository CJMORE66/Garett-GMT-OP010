DATA_BLOCK "AutoProcess_HMI"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      IndexProcess : Int;   // 1 A_ScanRotate, 2 F_Robot1Grip1, 3 F_Robot1Grip2, 4 B_Press1, 5 C_Glue, 6 F_Robot2Grip1, 7 F_Robot2Grip2, 8 C_GlueNGBuffer, 9 C_MagnScanNGBuffer, 10 B_Press2, 11 F_Robot3Grip1, 12 F_Robot3Grip2, 13 H_ShafeLine, 14 J_ShafeLine, 15 K_ShafeLine, 16 L_ShafeLine
      ActualSHowingData { S7_SetPoint := 'False'} : "ProcessData";
      Data_handling : Struct
         DeleteData : Bool;
         UpdateData_switch : Bool;
         UpdateData_Confirm : Bool;   // 1. step - request to confirm old new data
         FinalConfirm_Write : Bool;   // 2.  final acceptance for data update
         ChangePending : Bool;   // changes are ready for actual index
         ConfirmDialogActive : Bool;   // Confirm dialog active
         LastIndex : Int;   // internal - memory for last index
      END_STRUCT;
      StationHasProduct : Array[1..16] of Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

