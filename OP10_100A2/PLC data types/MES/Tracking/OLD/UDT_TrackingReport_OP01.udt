TYPE "UDT_TrackingReport_OP01"
VERSION : 0.1
   STRUCT
      "Date" {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      "P-LineID" : String[18];
      "P-StationID" : String[18];
      "P-PalletNo" : Int;
      "P-PalletType" : Byte;
      "P-PalletStatus" : Byte;
      "P-CT_Total" : Real;
      "P-CT_Sub" : Array[1..20] of Real;
      "P-Data" { S7_SetPoint := 'False'} : "PLCtoMES_OP_ProcessData_OP220";
      "P-PartID" : Array[1..10] of String[48];
      "P-SubPartID" : Array[1..10] of String[48];
   END_STRUCT;

END_TYPE

