[
    {
        "id": "op10-flow",
        "type": "tab",
        "label": "OP10 IIoT Flow",
        "disabled": false,
        "info": "Main IIoT flow for OP10 station"
    },
    {
        "id": "telemetry-sub",
        "type": "mqtt in",
        "z": "op10-flow",
        "name": "Subscribe Telemetry",
        "topic": "op10/telemetry/#",
        "qos": "1",
        "broker": "mosquitto",
        "datatype": "json",
        "x": 100,
        "y": 100,
        "wires": [["telemetry-parse"]]
    },
    {
        "id": "telemetry-parse",
        "type": "function",
        "z": "op10-flow",
        "name": "Parse Telemetry",
        "func": "msg.payload = {\n    timestamp: msg.payload.timestamp || new Date().toISOString(),\n    node_id: msg.payload.node_id,\n    value: msg.payload.value,\n    quality: msg.payload.quality\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 300,
        "y": 100,
        "wires": [["influx-write", "alert-check"]]
    },
    {
        "id": "influx-write",
        "type": "influxdb out",
        "z": "op10-flow",
        "name": "Write to InfluxDB",
        "influxdb": "InfluxDB_OP10",
        "measurement": "telemetry",
        "x": 550,
        "y": 100,
        "wires": []
    },
    {
        "id": "alert-check",
        "type": "function",
        "z": "op10-flow",
        "name": "Check Thresholds",
        "func": "const value = msg.payload.value;\nconst nodeId = msg.payload.node_id;\nlet alert = null;\n\n// Vibration thresholds\nif (nodeId.includes('Vibration')) {\n    if (value > 5.0) {\n        alert = { severity: 'critical', message: 'Vibration threshold exceeded' };\n    } else if (value > 3.0) {\n        alert = { severity: 'warning', message: 'Vibration high' };\n    }\n}\n\n// Temperature thresholds\nif (nodeId.includes('TempMotor') && value > 70) {\n    alert = { severity: 'critical', message: 'Motor temperature critical' };\n} else if (nodeId.includes('TempMotor') && value > 55) {\n    alert = { severity: 'warning', message: 'Motor temperature high' };\n}\n\nif (alert) {\n    msg.payload = {\n        timestamp: new Date().toISOString(),\n        node_id: nodeId,\n        value: value,\n        ...alert\n    };\n    return [msg, null];\n}\n\nreturn [null, msg];",
        "outputs": 2,
        "x": 550,
        "y": 180,
        "wires": [["alert-publish"], ["normal-flow"]]
    },
    {
        "id": "alert-publish",
        "type": "mqtt out",
        "z": "op10-flow",
        "name": "Publish Alert",
        "topic": "op10/alerts",
        "qos": "1",
        "retain": "false",
        "broker": "mosquitto",
        "x": 800,
        "y": 140,
        "wires": []
    },
    {
        "id": "normal-flow",
        "type": "debug",
        "z": "op10-flow",
        "name": "Debug",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "x": 800,
        "y": 220,
        "wires": []
    },
    {
        "id": "ml-results",
        "type": "mqtt in",
        "z": "op10-flow",
        "name": "ML Results",
        "topic": "op10/ml/results",
        "qos": "1",
        "broker": "mosquitto",
        "datatype": "json",
        "x": 100,
        "y": 300,
        "wires": [["ml-parse"]]
    },
    {
        "id": "ml-parse",
        "type": "function",
        "z": "op10-flow",
        "name": "Parse ML Results",
        "func": "msg.payload = {\n    timestamp: msg.payload.timestamp,\n    anomaly: msg.payload.anomaly,\n    probability: msg.payload.probability,\n    rul_days: msg.payload.rul_days\n};\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 300,
        "wires": [["ml-influx", "rul-check"]]
    },
    {
        "id": "ml-influx",
        "type": "influxdb out",
        "z": "op10-flow",
        "name": "Write ML to InfluxDB",
        "influxdb": "InfluxDB_OP10",
        "measurement": "ml_results",
        "x": 550,
        "y": 300,
        "wires": []
    },
    {
        "id": "rul-check",
        "type": "switch",
        "z": "op10-flow",
        "name": "RUL Check",
        "checkall": "true",
        "rules": [
            { "t": "lt", "v": "payload.rul_days", "vt": "num", "v": "7" },
            { "t": "lt", "v": "payload.rul_days", "vt": "num", "v": "30" }
        ],
        "outputs": 2,
        "x": 550,
        "y": 380,
        "wires": [["rul-critical"], ["rul-warning"]]
    },
    {
        "id": "rul-critical",
        "type": "mqtt out",
        "z": "op10-flow",
        "name": "RUL Critical Alert",
        "topic": "op10/alerts/rul/critical",
        "qos": "1",
        "retain": "false",
        "broker": "mosquitto",
        "x": 800,
        "y": 340,
        "wires": []
    },
    {
        "id": "rul-warning",
        "type": "mqtt out",
        "z": "op10-flow",
        "name": "RUL Warning Alert",
        "topic": "op10/alerts/rul/warning",
        "qos": "1",
        "retain": "false",
        "broker": "mosquitto",
        "x": 800,
        "y": 420,
        "wires": []
    },
    {
        "id": "product-events",
        "type": "mqtt in",
        "z": "op10-flow",
        "name": "Product Events",
        "topic": "op10/product/status",
        "qos": "1",
        "broker": "mosquitto",
        "datatype": "json",
        "x": 100,
        "y": 500,
        "wires": [["product-parse"]]
    },
    {
        "id": "product-parse",
        "type": "function",
        "z": "op10-flow",
        "name": "Parse Product Event",
        "func": "msg.topic = 'product/' + msg.payload.status;\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 500,
        "wires": [["product-debug"]]
    },
    {
        "id": "product-debug",
        "type": "debug",
        "z": "op10-flow",
        "name": "Product Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "x": 550,
        "y": 500,
        "wires": []
    }
]
