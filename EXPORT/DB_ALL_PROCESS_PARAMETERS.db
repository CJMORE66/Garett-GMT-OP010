TYPE "UDT_Motion_Point_IAI"
VERSION : 0.1
// =================================================================================
// UDT_Recipe_Final.scl
// Version: Final
//
// Description:
// Final, definitive recipe structure based on deep code analysis.
// - Axis names and mapping are CORRECT.
// - Position names are simple and numeric (Position_01, Position_02, ...)
//   to provide a safe, 1-to-1 mapping with the axis driver's position array.
//   This structure can be used to build a descriptive HMI.
// =================================================================================
// =================================================================================
// BASE TYPES for Motion Points
// =================================================================================
   STRUCT
      Pos : Real;   //  Target Position (um/pulse)
      Vel : Int;   //  Target Velocity (mm/s or %)
   END_STRUCT;

END_TYPE

TYPE "UDT_Motion_Point_V90"
VERSION : 0.1
   STRUCT
      Pos : DInt;   //  Target Position (mm/deg)
      Vel : Int;   //  Target Velocity (mm/s or rpm)
   END_STRUCT;

END_TYPE

TYPE "UDT_Recipe_PressCurve"
VERSION : 0.1
// NOTE: UDT_Recipe_PressCurve and UDT_Recipe_ATEQ are assumed to exist from original project files.
// =================================================================================
// MAIN RECIPE UDT - FINAL VERSION
// =================================================================================
   STRUCT
      StartPos_UL : Real;
      StartPos_LL : Real;
      StartForce_UL : Real;
      StartForce_LL : Real;
      MiddlePos_UL : Real;
      MiddlePos_LL : Real;
      MiddleForce_UL : Real;
      MiddleForce_LL : Real;
      FinalPos_UL : Real;
      FinalPos_LL : Real;
      FinalForce_UL : Real;
      FinalForce_LL : Real;
      ProgramNum : Int;
   END_STRUCT;

END_TYPE

TYPE "UDT_Gripper_Fixture_Codes"
VERSION : 0.1
// =================================================================================
// OTHER UDTs (Grippers, Process, etc. - Unchanged from previous correct versions)
// =================================================================================
   STRUCT
      "JAW TOOLING LEFT" : String[128];
      "JAW TOOLING RIGHT" : String[128];
      "SHAFT CLAMPING LEFT" : String[128];
      "SHAFT CLAMPING RIGHT" : String[128];
   END_STRUCT;

END_TYPE

TYPE "UDT_IAI_Axis_Positions"
VERSION : 0.1
// =================================================================================
// POSITION SETS - Mirroring the Axis Driver's Position Array
// =================================================================================
   STRUCT
      Position : Array[1..20] of "UDT_Motion_Point_IAI";
   END_STRUCT;

END_TYPE

TYPE "UDT_V90_Axis_Positions"
VERSION : 0.1
   STRUCT
      Position : Array[1..20] of "UDT_Motion_Point_V90";
   END_STRUCT;

END_TYPE

TYPE "UDT_OP10_Recipe_type"
VERSION : 0.1
   STRUCT
      Header : Struct   // Information about recipe
         RecipeName : String[50];   // name of product
         RecipeID : USInt;   // number of product for sig exch. and other processes
         "Version" : UInt;   // version of update that structure
         LastModified {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // time of last modifiacation
         PartType : String[28];   // second name for product - additional one
         PartTypeRecordNr : Int;   // PartType Record number same like recipi id for future sig exchanges etc
      END_STRUCT;
      Process : Struct   // Important process parameters how should machine act
         Timers : Struct   // Definition of times for processess
            Delay_glue_init_start : Time := t#2s;
            Delay_Medium : Time;
            Delay_Long : Time;
            Cylinder_ActTime : Time;
         END_STRUCT;
         Limits : Struct   // limitations of the values
            RetryLimit : Int;
         END_STRUCT;
         Press : Struct   // parameters for the kistler press devices
            B1_Program : Int;
            B2_Program : Int;
            Curve : "UDT_Recipe_PressCurve";
         END_STRUCT;
         Vision : Struct   // camera system programs numbers
            CGlueShaftIV3_Progs : Array[1..4] of Word;
            CGlueMagnetIV3_Prog : Word;
            CGlueProgram : Int;
         END_STRUCT;
      END_STRUCT;
      "Tooling Code" : Struct   // QR CODES OF THE TOOLING FOR THE RECIPE
         A1_Table : Array[1..8] of String[128];
         A2_Table : Array[1..8] of String[128];   //  ... other fixture codes Descriptive Gripper Fixture Codes
         ROB1_Shaft_Handling_Robot : Struct   //  R1
            Gripper : "UDT_Gripper_Fixture_Codes";
         END_STRUCT;
         ROB2_Main_Assembly_Robot : Struct   //  R2
            Gripper : "UDT_Gripper_Fixture_Codes";
         END_STRUCT;
         ROB3_Unloading_Robot : Struct   //  R3
            Gripper : "UDT_Gripper_Fixture_Codes";
         END_STRUCT;
         A1_Fixtures : Struct
            A1RingUnloadingFixtureCode : String[128];
            E1LoadingNGFixtureCode : String[128];
            ShaftScanFixtureCode : String[128];
            B1PressFixtureCode : String[128];
            CGlueFixtureCode : String[128];
            B1PressCylFixtureCode : String[128];
         END_STRUCT;
         A2_Fixtures : Struct
            A2RingUnloadingFixtureCode : String[128];
            E2UnloadingNGFixtureCode : String[128];
            B2PressFixtureCode : String[128];
            CGlueNGFixtureCode : String[128];
            B2PressCylFixtureCode : String[128];
         END_STRUCT;
      END_STRUCT;
      Motion : Struct   // ALL SERVO DRIVES PARAMETERS 
         Gluing_Nozzle_Z : "UDT_IAI_Axis_Positions";   //  Physical Axis: IAI_A1
         Gluing_Nozzle_X : "UDT_IAI_Axis_Positions";   //  Physical Axis: IAI_A2
         Gluing_Nozzle_Y : "UDT_IAI_Axis_Positions";   //  Physical Axis: IAI_A3 CORRECTED V90 Axis Functions (from user)
         Ring_Turntable_Axis_1 : "UDT_V90_Axis_Positions";   //  Physical Axis: V90_A1
         Shaft_Scan_Turntable_Axis : "UDT_V90_Axis_Positions";   //  Physical Axis: V90_A2
         Gluing_Rotary_Jig_Axis : "UDT_V90_Axis_Positions";   //  Physical Axis: V90_A3
         Ring_Turntable_Axis_2 : "UDT_V90_Axis_Positions";   //  Physical Axis: V90_A4
      END_STRUCT;
   END_STRUCT;

END_TYPE

