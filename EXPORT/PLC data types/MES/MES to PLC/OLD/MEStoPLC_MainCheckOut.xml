  <Section Name="None">
    <Member Name="M-DataSaveDone" Datatype="Bool">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">false</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="zh-CN">过程数据采集完成标志位，此信号串入放行逻辑，MES置位后PLC立即复位请求数据采集信号P-DataReady，P-DataReady下降沿由MES复位此信号</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="M-DataSaveOK" Datatype="Bool">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">false</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="zh-CN">工件可加工标志位，PLC收到M-ReqMesDone+此信号后可开始加工</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="M-DataSaveNG" Datatype="Bool">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">false</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="zh-CN">工件可不加工标志位，PLC收到M-ReqMesDone+此信号后可放行</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="M-DataSaveErrCode" Datatype="Int">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">false</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="zh-CN">【预留】“M-ErrorMsg”失效的时候启用</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="M-DataSaveErrMsg" Datatype="String[98]">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">false</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="zh-CN">P-ReqMes请求Mes标志位收到后，如果Mes对请求的数据校验有异常，写入相应中文字符串，M-ReqMesDone信号超时后将中文字符串显示到HMI</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="Reserve" Datatype="Array[1..2096] of Byte">
      <AttributeList>
        <BooleanAttribute Name="ExternalAccessible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalVisible" SystemDefined="true">true</BooleanAttribute>
        <BooleanAttribute Name="ExternalWritable" SystemDefined="true">true</BooleanAttribute>
