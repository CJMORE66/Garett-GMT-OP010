(* Transition 100: ProcessStart -> Determine product status *)
IF Step_ProcessStart_active AND ( (NOT ioPM_Inface.AlarmCycleStop) AND ioPM_Inface.Running AND (NOT iSysInface.Auto.RunningOver) AND ( (NOT iSysInface.Auto.OneCycleMode) OR (iSysInface.Auto.OneCycleMode AND ioPM_Inface.TriggerOneCycle) ) ) THEN
  Step_ProcessStart_active := FALSE;
  Action_ProcessStart_Exec := FALSE;
  
  Step_DetermineProductStatus_active := TRUE;
  Step_DetermineProductStatus_entry_time := SYS_TIME; (* Reset Timer *)
