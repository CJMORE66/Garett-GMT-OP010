Action_NGCount_Done := FALSE;
Action_MESResultOK_1_Done := FALSE;
Action_RequestRobotPick_Done := FALSE;
Action_MESResult_Done := FALSE;
Action_MESCheckFinish_Done := FALSE;
Action_RobotPick_Done := FALSE;
Action_DataClear_Done := FALSE;
Action_ProcessFinsh_3_Done := FALSE;
Action_WaitRobotFinishTask_1_Done := FALSE;
Action_DataMove_Done := FALSE;
Action_WaitRobotInSafetyArea_Done := FALSE;
Action_PressProgram_1_Done := FALSE;
Action_PressHoming_1_Done := FALSE;
Action_PressReady_q_1_Done := FALSE;
Action_PressHoming_q_1_Done := FALSE;
Action_Step15_Done := FALSE;
Action_B_PressFitting_01CylinderToHP_1_Done := FALSE;
Action_ResetMesUnloadRequest_1_Done := FALSE;
Action_PrepareMESCheckData_1_Done := FALSE;
Action_StartCycle_Done := FALSE;
Action_ResetPressStart_Done := FALSE;
Action_ProcessFInish_1_Done := FALSE;
Action_CheckPressResult_Done := FALSE;
Action_Step147_Done := FALSE;


(* Sequence: S01-S99 Initial *)
(* S01-S99  初始化 *)
(* Step F14_Initial *)
(* EN: Step structure *)
IF Step_F14_Initial_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_F14_Initial_entry_time) > F14_Initial.T_MAX THEN Step_F14_Initial_timeout := TRUE; END_IF;

  IF Action_F14_Initial_Exec THEN
    #ioPM_Inface.InitialRun := TRUE;
    #ioPM_Inface.InitialOK := FALSE;
    #ioPM_Inface.WaitRunning := FALSE;
    #ioPM_Inface.Running := FALSE;
    #ioPM_Inface.ProcessComplete := FALSE;
    #ioPM_Inface.UnPause := FALSE;
    "Station_Sys".Cmd.Calibration := FALSE;
    "Station_Sys".Cmd.ChangeOver := FALSE;
    //"ST350_Sys".Cmd.DryRun
    "Station_Sys".Cmd.Reserve := FALSE;
    "Station_Sys".Cmd.OneCycle := FALSE;
    "DB_maXYmosNC2".StartCycle := FALSE;
    "DB_maXYmosNC2".StartCycle := FALSE;
    #ioPM_Inface.ProcessStart := FALSE;
    "AutoProcessControl".B_Press_2.Robot3PickPrimit := FALSE;
    "AutoProcessControl".B_Press_2.Robot3PutRingPrimit := FALSE;
    "AutoProcessControl".B_Press_2.Robot2PutPrimit := FALSE;
    Action_F14_Initial_Done := TRUE;
  END_IF;
END_IF;

(* Step S2 *)
(* EN: Step structure *)
IF Step_S2_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_S2_entry_time) > S2.T_MAX THEN Step_S2_timeout := TRUE; END_IF;

  IF Action_S2_Exec THEN
    Action_S2_Done := TRUE;
  END_IF;
END_IF;

(* Step S4 *)
(* EN: Step structure *)
IF Step_S4_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_S4_entry_time) > S4.T_MAX THEN Step_S4_timeout := TRUE; END_IF;

  IF Action_S4_Exec THEN
    Action_S4_Done := TRUE;
  END_IF;
END_IF;

(* Step S5_MESInitial *)
(* EN: Step structure *)
IF Step_S5_MESInitial_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_S5_MESInitial_entry_time) > S5_MESInitial.T_MAX THEN Step_S5_MESInitial_timeout := TRUE; END_IF;

  IF Action_S5_MESInitial_Exec THEN
    Action_S5_MESInitial_Done := TRUE;
  END_IF;
END_IF;

(* Step S10_InitialFinish *)
(* EN: Step structure *)
IF Step_S10_InitialFinish_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_S10_InitialFinish_entry_time) > S10_InitialFinish.T_MAX THEN Step_S10_InitialFinish_timeout := TRUE; END_IF;

  IF Action_S10_InitialFinish_Exec THEN
    #ioPM_Inface.InitialOK := TRUE;
    Action_S10_InitialFinish_Done := TRUE;
  END_IF;
END_IF;

(* Step S3 *)
(* EN: Step structure *)
IF Step_S3_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_S3_entry_time) > S3.T_MAX THEN Step_S3_timeout := TRUE; END_IF;

  IF Action_S3_Exec THEN
    Action_S3_Done := TRUE;
  END_IF;
END_IF;

(* Step PressProgram *)
(* EN: Step structure *)
IF Step_PressProgram_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_PressProgram_entry_time) > PressProgram.T_MAX THEN Step_PressProgram_timeout := TRUE; END_IF;

  IF Action_PressProgram_Exec THEN
    IF NOT "ST10_GeneralData".FunctionDeSelect.B.FunctionDeSelected_TestPress375A1 THEN
      "DB_maXYmosNC2".ProgNo := 1;
    END_IF;
    Action_PressProgram_Done := TRUE;
  END_IF;
END_IF;

(* Step PressHoming *)
(* EN: Step structure *)
IF Step_PressHoming_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_PressHoming_entry_time) > PressHoming.T_MAX THEN Step_PressHoming_timeout := TRUE; END_IF;

  IF Action_PressHoming_Exec THEN
    "DB_maXYmosNC2".Homing := TRUE;
    Action_PressHoming_Done := TRUE;
  END_IF;
END_IF;

(* Step PressReady? *)
(* EN: Step structure *)
IF Step_PressReady_q_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_PressReady_q_entry_time) > PressReady_q.T_MAX THEN Step_PressReady_q_timeout := TRUE; END_IF;

  IF Action_PressReady_q_Exec THEN
    Action_PressReady_q_Done := TRUE;
  END_IF;
END_IF;

(* Step PressHoming? *)
(* EN: Step structure *)
IF Step_PressHoming_q_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_PressHoming_q_entry_time) > PressHoming_q.T_MAX THEN Step_PressHoming_q_timeout := TRUE; END_IF;

  IF Action_PressHoming_q_Exec THEN
    Action_PressHoming_q_Done := TRUE;
  END_IF;
END_IF;

(* Step Step14 *)
(* EN: Step structure *)
IF Step_Step14_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_Step14_entry_time) > Step14.T_MAX THEN Step_Step14_timeout := TRUE; END_IF;

  IF Action_Step14_Exec THEN
    Action_Step14_Done := TRUE;
  END_IF;
END_IF;

(* Step CheckPressGripStatus *)
(* EN: Step structure *)
IF Step_CheckPressGripStatus_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_CheckPressGripStatus_entry_time) > CheckPressGripStatus.T_MAX THEN Step_CheckPressGripStatus_timeout := TRUE; END_IF;

  IF Action_CheckPressGripStatus_Exec THEN
    Action_CheckPressGripStatus_Done := TRUE;
  END_IF;
END_IF;

(* Step B-PressFitting-01GripperCylinderToHP *)
(* EN: Step structure *)
IF Step_B_PressFitting_01GripperCylinderToHP_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_B_PressFitting_01GripperCylinderToHP_entry_time) > B_PressFitting_01GripperCylinderToHP.T_MAX THEN Step_B_PressFitting_01GripperCylinderToHP_timeout := TRUE; END_IF;

  IF Action_B_PressFitting_01GripperCylinderToHP_Exec THEN
    "ST10Cylinder".Cy[7].Inout.AutoGoHome := TRUE;
    "ST10Cylinder".Cy[7].Inout.AutoGoWork := FALSE;
    Action_B_PressFitting_01GripperCylinderToHP_Done := TRUE;
  END_IF;
END_IF;

(* Step CheckRingExist *)
(* EN: Step structure *)
IF Step_CheckRingExist_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_CheckRingExist_entry_time) > CheckRingExist.T_MAX THEN Step_CheckRingExist_timeout := TRUE; END_IF;

  IF Action_CheckRingExist_Exec THEN
    Action_CheckRingExist_Done := TRUE;
  END_IF;
END_IF;

(* Step Status Alarm *)
(* EN: Step structure *)
IF Step_StatusAlarm_active THEN
  (* Timeout Check *)
  IF (SYS_TIME - Step_StatusAlarm_entry_time) > StatusAlarm.T_MAX THEN Step_StatusAlarm_timeout := TRUE; END_IF;

  IF Action_StatusAlarm_Exec THEN
    "ST10_DeviceError".B.B2Press.StatusError := TRUE;
    Action_StatusAlarm_Done := TRUE;
  END_IF;
END_IF;

(* Step B-PressFitting-01GripperCylinderToWP *)
(* EN: Step structure *)
IF Step_B_PressFitting_01GripperCylinderToWP_active THEN
  (* Timeout Check *)
