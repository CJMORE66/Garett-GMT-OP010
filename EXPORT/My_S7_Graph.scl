BEGIN

(* Pre-Operations *)

(* Network 1 *)
(* TON: 工位11有托盘 *)
TON[10].IN := "AlwaysTRUE" AND "Station_Sys".Alarm.ImmediatelyStop;
TON[10].PT := T#300ms;
#ioPM_Inface.AlarmImdilyStop := TON[10].Q;

(* Network 2 *)
#ioPM_Inface.AlarmCycleStop := "AlwaysTRUE" AND "Station_Sys".Alarm.CycleStop;

(* Network 3 *)
(* Call: SysFlowCtrlGraph *)
#sCtrlMode.iSysInface := iSysInface;
#sCtrlMode.ioPM_Inface := ioPM_Inface;
#sCtrlMode.ioGraphCtrl := #RT_DATA.MOP;
#sCtrlMode();

(* Network 4 *)
(* TON: 工位11有托盘 *)
TON[0].IN := "AlwaysTRUE" AND "iB-PressFitting-02ShaftDetection";
TON[0].PT := T#500ms;

(* TOF: 工位无托盘 *)
TOF[1].IN := NOT "iB-PressFitting-02ShaftDetection";
TOF[1].PT := T#300ms;

(* TON *)
TON[2].IN := "AlwaysTRUE" AND "iB-PressFitting-02DownRingDetection";
TON[2].PT := T#300ms;

(* TOF *)
TOF[3].IN := NOT "iB-PressFitting-02DownRingDetection";
TOF[3].PT := T#300ms;

(* TON *)
TON[4].IN := "AlwaysTRUE" AND "iB-PressFitting-02UpRingDetection";
TON[4].PT := T#300ms;

(* TON *)
TON[5].IN := NOT "iB-PressFitting-02UpRingDetection";
TON[5].PT := T#300ms;

(* Network 5 *)
#前站站号 := 345;
#本站站号 := 350;


(* *** State Machine Logic *** *)

(* Reset all action flags at the start of the cycle *)
Action_F14_Initial_Done := FALSE;
Action_S2_Done := FALSE;
Action_S4_Done := FALSE;
Action_S5_MESInitial_Done := FALSE;
Action_S10_InitialFinish_Done := FALSE;
Action_S3_Done := FALSE;
