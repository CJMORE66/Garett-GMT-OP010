    ELSIF Step_DataMove_active AND Trans_Trans258_executed THEN
      Step_DataMove_active := FALSE;
      Action_DataMove_Exec := FALSE;
      
      Step_WaitRobotInSafetyArea_active := TRUE;
      Step_WaitRobotInSafetyArea_entry_time := SYS_TIME;
      Action_WaitRobotInSafetyArea_Exec := TRUE;
    ELSIF Step_WaitRobotInSafetyArea_active AND Trans_Trans261_executed THEN
      Step_WaitRobotInSafetyArea_active := FALSE;
      Action_WaitRobotInSafetyArea_Exec := FALSE;
      
      Step_DataClear_active := TRUE;
      Step_DataClear_entry_time := SYS_TIME;
      Action_DataClear_Exec := TRUE;
    ELSIF Step_DataClear_active AND Trans_Trans290_executed THEN
      Step_DataClear_active := FALSE;
      Action_DataClear_Exec := FALSE;
      
      Step_ProcessFinsh_3_active := TRUE;
      Step_ProcessFinsh_3_entry_time := SYS_TIME;
      Action_ProcessFinsh_3_Exec := TRUE;
    END_IF;
  END_IF;
END_IF;


(* Post-Operations *)

(* Network 1 *)
#ioPM_Inface.StepNum := #RT_DATA.S_DISPLAY;

(* Network 2 *)
IF iSysInface.Reset THEN
  #AlarmID := 0;
END_IF;

(* Network 3 *)
TON[10].IN := #工件放行中;
TON[10].PT := T#0.5s;
#工件放行中 := FALSE;

END_FUNCTION_BLOCK