Action_B_PressFitting_01GripperCylinderToHP_Done := FALSE;
Action_CheckRingExist_Done := FALSE;
Action_StatusAlarm_Done := FALSE;
Action_B_PressFitting_01GripperCylinderToWP_Done := FALSE;
Action_B_PressFitting_01CylinderToHP_Done := FALSE;
