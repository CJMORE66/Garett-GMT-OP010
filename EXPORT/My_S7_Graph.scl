Action_ShaftAndRingOK_Done := FALSE;
Action_Press_NG_Done := FALSE;
Action_MES_Done := FALSE;
Action_MESOK_Done := FALSE;
Action_WaitRobotFinishTask_1_1_Done := FALSE;
Action_RequestRobotPutRing_Done := FALSE;
Action_Part_Check_Done := FALSE;
Action_ProductCheckAlarm_Done := FALSE;
Action_ProductCheckAlarm_1_Done := FALSE;
Action_RobotLeavePressArea_1_Done := FALSE;
Action_RobotLeavePress_Area_Done := FALSE;
Action_PartStatus_Done := FALSE;
Action_MES_1NG_Done := FALSE;
Action_MES_Check_In_Done := FALSE;
Action_MESOverTime_1_Done := FALSE;
Action_MESCheckNG_2_Done := FALSE;
Action_ResetMesCheckRequest_Done := FALSE;
Action_PrepareMESCheckData_Done := FALSE;
Action_MesCheckIn_1_Done := FALSE;
Action_CheckFinish_1_Done := FALSE;
Action_Bypass_Done := FALSE;
Action_Step313_Done := FALSE;
Action_MESCheckNG_3_Done := FALSE;
Action_Bypass_1_Done := FALSE;
