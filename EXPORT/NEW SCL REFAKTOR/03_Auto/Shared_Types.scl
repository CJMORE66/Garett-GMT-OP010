// =============================================================
// COMMON ERROR CODES
// =============================================================

TYPE
    E_ErrorCode : (
        ERR_NoError                    := 0,
        ERR_PalletTimeout              := 16#3001,
        ERR_PalletPosition             := 16#3002,
        ERR_ScanTimeout                := 16#3101,
        ERR_ScanFailed                 := 16#3102,
        ERR_RFIDTimeout                := 16#3201,
        ERR_RFIDFailed                 := 16#3202,
        ERR_ProductMissing             := 16#3301,
        ERR_ProductNG                  := 16#3302,
        ERR_FixtureNG                  := 16#3401,
        ERR_DataValidation             := 16#3501,
        ERR_TransferTimeout            := 16#3601,
        ERR_PressTimeout               := 16#4001,
        ERR_PressForceNG               := 16#4002,
        ERR_GlueTimeout                := 16#5001,
        ERR_GlueNG                     := 16#5002,
        ERR_CureTimeout                := 16#5101,
        ERR_SafetyGate                 := 16#9001,
        ERR_EStop                      := 16#9002,
        ERR_General                    := 16#FFFF
    ) WORD := 0;
END_TYPE

// =============================================================
// COMMON CONSTANTS
// =============================================================

CONST
    // Timeout defaults
    TIMEOUT_SHORT                    := T#2s;
    TIMEOUT_MEDIUM                   := T#5s;
    TIMEOUT_LONG                     := T#10s;
    TIMEOUT_EXTENDED                 := T#30s;

    // Common step ranges
    STEP_INIT_RANGE                  := 0..29;
    STEP_READY_RANGE                 := 30..99;
    STEP_PROCESS_RANGE               := 100..899;
    STEP_ERROR_RANGE                 := 900..949;
    STEP_DONE_RANGE                  := 950..999;

    // System flags
    FALSE_VALUE                      := 0;
    TRUE_VALUE                       := 1;
END_CONST

// =============================================================
// TRANSITION FUNCTIONS
// Common transition logic reusable across flow blocks
// =============================================================

FUNCTION "Trans_PalletPresent" : Bool
VAR_INPUT
    Sensor : Bool;
    Timeout : Time;
END_VAR
VAR_IN_OUT
    Timer : TON_TIME;
END_VAR
BEGIN
    // Transition: Pallet is present within timeout
    "Trans_PalletPresent" := Sensor AND NOT Timer.Q;
    Timer(IN := NOT Sensor, PT := Timeout);
END_FUNCTION

FUNCTION "Trans_ScanComplete" : Bool
VAR_INPUT
    BusySignal : Bool;
    ResultOK : Bool;
    Timeout : Time;
END_VAR
VAR_IN_OUT
    Timer : TON_TIME;
END_VAR
BEGIN
    // Transition: Scan complete with OK result
    "Trans_ScanComplete" := (NOT BusySignal) AND ResultOK AND NOT Timer.Q;
    Timer(IN := BusySignal, PT := Timeout);
END_FUNCTION

FUNCTION "Trans_TransferComplete" : Bool
VAR_INPUT
    CompleteSignal : Bool;
    Timeout : Time;
END_VAR
VAR_IN_OUT
    Timer : TON_TIME;
END_VAR
BEGIN
    // Transition: Transfer operation complete
    "Trans_TransferComplete" := CompleteSignal AND NOT Timer.Q;
    Timer(IN := NOT CompleteSignal, PT := Timeout);
END_FUNCTION

FUNCTION "Trans_ErrorReset" : Bool
VAR_INPUT
    ErrorFlag : Bool;
    ResetCmd : Bool;
END_VAR
BEGIN
    // Transition: Error can be reset
    "Trans_ErrorReset" := ErrorFlag AND ResetCmd;
END_FUNCTION

FUNCTION "Trans_NextCycle" : Bool
VAR_INPUT
    CycleDone : Bool;
    NextCmd : Bool;
END_VAR
BEGIN
    // Transition: Ready for next cycle
    "Trans_NextCycle" := CycleDone AND NextCmd;
END_FUNCTION
