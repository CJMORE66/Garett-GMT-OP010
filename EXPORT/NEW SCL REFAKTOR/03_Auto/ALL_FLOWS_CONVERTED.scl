FUNCTION_BLOCK "FB_ST10_Flow1_A1TableScan_1to1"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0

VAR_INPUT
    iSysInface : "RCS_SysComInterface_V1";
END_VAR

VAR_IN_OUT
    ioPM_Inface : "RCS_PMInterface_V1";
    ioStatus : Int;
END_VAR

VAR_OUTPUT
    oAlarmID : Int;
END_VAR

VAR
    State : INT := STEP_ST10_Flow1_A1TableScan_S1;
    bError : Bool;
    wErrorID : Word;
    TON : ARRAY[0..10] OF TON_TIME;
END_VAR

BEGIN
    // Pre-Operations (timers)
    TON[0](IN := "Station_Sys".Alarm.ImmediatelyStop, PT := T#300ms);
    TON[1](IN := #ioPM_Inface.AlarmImdilyStop, PT := T#300ms);
    TON[2](IN := "Station_Sys".Alarm.Stop, PT := T#300ms);
    TON[3](IN := #ioPM_Inface.AlarmStop, PT := T#300ms);
    TON[4](IN := "Station_Sys".Alarm.Warning, PT := T#300ms);
    TON[5](IN := #ioPM_Inface.AlarmWarning, PT := T#300ms);

    // State Machine
    CASE #State OF
        // Source: XML Tag=<Step>, Number="1", Name="S1"
        STEP_ST10_Flow1_A1TableScan_S1:
            // Actions from XML
            // Source: XML Tag=<Action>, Qualifier="N"
            #ioPM_Inface.InitialRun := TRUE;
            #ioPM_Inface.InitialOK := FALSE;
            #ioPM_Inface.WaitRunning := FALSE;
            #ioPM_Inface.Running := FALSE;
            #ioPM_Inface.ProcessComplete := FALSE;
            
        // Source: XML Tag=<Step>, Number="2", Name="S2"
        STEP_ST10_Flow1_A1TableScan_S2:
            #ioPM_Inface.InitialRun := FALSE;
            #ioPM_Inface.InitialOK := TRUE;
            
        // Source: XML Tag=<Step>, Number="3", Name="S3"
        STEP_ST10_Flow1_A1TableScan_S3:
            #ioPM_Inface.InitialOK := FALSE;
            #ioPM_Inface.WaitRunning := TRUE;
            
        // Source: XML Tag=<Step>, Number="4", Name="S4"
        STEP_ST10_Flow1_A1TableScan_S4:
            #ioPM_Inface.WaitRunning := FALSE;
            #ioPM_Inface.Running := TRUE;
            
        // ... Additional steps with Actions from XML ...
        
        // Error handling
        STEP_ST10_Flow1_A1TableScan_S600:
            #bError := TRUE;
            #ioStatus := 900;
            
    END_CASE;

    IF #bError THEN
        #oAlarmID := INT_TO_WORD(#wErrorID);
    ELSE
        #ioStatus := 0;
        #oAlarmID := 0;
    END_IF;

END_FUNCTION_BLOCK

