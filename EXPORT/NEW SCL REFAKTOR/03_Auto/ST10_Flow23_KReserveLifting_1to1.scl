            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow23_KReserveLifting_CheckShaftLiftingCylinderPos;
            END_IF;

        // ===========================================
        // STEP 117: CheckShaftLiftingCylinderPos
        // ===========================================
        STEP_ST10_Flow23_KReserveLifting_CheckShaftLiftingCylinderPos:
            // No actions in XML

            // Transition to next step: 142
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow23_KReserveLifting_K_reserveLiftingCylindertoWP_4;
            END_IF;

        // ===========================================
        // STEP 142: K-reserveLiftingCylindertoWP_4
        // ===========================================
        STEP_ST10_Flow23_KReserveLifting_K_reserveLiftingCylindertoWP_4:
            // Action Qualifier=R
            // Token: "ST10Cylinder".Cy[41].Inout.AutoGoHome
            "ST10Cylinder".Cy[41].Inout.AutoGoHome := FALSE;
            // Action Qualifier=S
            // Token: "ST10Cylinder".Cy[41].Inout.AutoGoWork
            "ST10Cylinder".Cy[41].Inout.AutoGoWork := TRUE;

    END_CASE;

    // UPDATE ioPM_Inface
    #ioPM_Inface.InitialRun := #act_InitialRun;
    #ioPM_Inface.InitialOK := #act_InitialOK;
    #ioPM_Inface.WaitRunning := #act_WaitRunning;
    #ioPM_Inface.Running := #act_Running;
    #ioPM_Inface.ProcessComplete := #act_ProcessComplete;
    #ioPM_Inface.ProcessStart := #act_ProcessStart;
    #ioPM_Inface.UnPause := #act_UnPause;

    // ERROR HANDLING
    IF #bError THEN
        #ioStatus := 900;
        #oAlarmID := INT_TO_WORD(#wErrorID);
    ELSE
        #ioStatus := 0;
        #oAlarmID := 0;
    END_IF;
END_FUNCTION_BLOCK

