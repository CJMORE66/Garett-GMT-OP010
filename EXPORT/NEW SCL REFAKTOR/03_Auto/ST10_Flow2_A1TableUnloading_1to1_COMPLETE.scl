        // =====================================================================
        // STEP 128: No Ring
        // Source: XML Tag=<Step>, Number="128", Name="No Ring"
        // =====================================================================
        STEP_Flow2_NoRing:
            // Actions: Empty (no actions defined in XML)
            // No actions to execute in this step

        // =====================================================================
        // STEP 130: Wait robot finish task
        // Source: XML Tag=<Step>, Number="130", Name="Wait robot finish task"
        // =====================================================================
        STEP_Flow2_130_WaitRobotFinishTask:
            // Actions: Empty (no actions defined in XML)
            // No actions to execute in this step

        // =====================================================================
        // DEFAULT: Unknown state
        // =====================================================================
    END_CASE;

    // ========================================================================
    // UPDATE ioPM_Inface - Apply stored action flags
    // Source: XML Tag=<Action>, Qualifier=S/R
    // ========================================================================

    #ioPM_Inface.InitialRun := #act_InitialRun;
    #ioPM_Inface.InitialOK := #act_InitialOK;
    #ioPM_Inface.WaitRunning := #act_WaitRunning;
    #ioPM_Inface.Running := #act_Running;
    #ioPM_Inface.ProcessComplete := #act_ProcessComplete;
    #ioPM_Inface.ProcessStart := #act_ProcessStart;
    #ioPM_Inface.UnPause := #act_UnPause;

    // ========================================================================
    // ERROR HANDLING
    // Source: XML Tag=<Alarm*>, various alarm categories
    // ========================================================================

    IF #bError THEN
        #ioStatus := 900;
        #oAlarmID := INT_TO_WORD(#wErrorID);
    ELSE
        #ioStatus := 0;
        #oAlarmID := 0;
    END_IF;

END_FUNCTION_BLOCK

