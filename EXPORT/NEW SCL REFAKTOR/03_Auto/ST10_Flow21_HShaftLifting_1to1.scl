            END_IF;

        // ===========================================
        // STEP 141: Motor Stop
        // ===========================================
        STEP_ST10_Flow21_HShaftLifting_Motor_Stop:
            // Action Qualifier=R
            // Token: "MotorControl".Dev[1].Auto.CCWStart
            "MotorControl".Dev[1].Auto.CCWStart := FALSE;
            // Action Qualifier=R
            // Token: "MotorControl".Dev[1].Auto.Start
            "MotorControl".Dev[1].Auto.Start := FALSE;

            // Transition to next step: 142
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow21_HShaftLifting_H_shaftLiftingLiftingCylinderToWP2;
            END_IF;

        // ===========================================
        // STEP 142: H-shaftLiftingLiftingCylinderToWP2
        // ===========================================
        STEP_ST10_Flow21_HShaftLifting_H_shaftLiftingLiftingCylinderToWP2:
            // Action Qualifier=R
            // Token: "ST10Cylinder".Cy[21].Inout.AutoGoHome
            "ST10Cylinder".Cy[21].Inout.AutoGoHome := FALSE;
            // Action Qualifier=S
            // Token: "ST10Cylinder".Cy[21].Inout.AutoGoWork
            "ST10Cylinder".Cy[21].Inout.AutoGoWork := TRUE;

            // Transition to next step: 5
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow21_HShaftLifting_S5_MESInitial;
            END_IF;

        // ===========================================
        // STEP 5: S5_MESInitial
        // ===========================================
        STEP_ST10_Flow21_HShaftLifting_S5_MESInitial:
            // No actions in XML

    END_CASE;

    // UPDATE ioPM_Inface
    #ioPM_Inface.InitialRun := #act_InitialRun;
    #ioPM_Inface.InitialOK := #act_InitialOK;
    #ioPM_Inface.WaitRunning := #act_WaitRunning;
    #ioPM_Inface.Running := #act_Running;
    #ioPM_Inface.ProcessComplete := #act_ProcessComplete;
    #ioPM_Inface.ProcessStart := #act_ProcessStart;
    #ioPM_Inface.UnPause := #act_UnPause;

    // ERROR HANDLING
    IF #bError THEN
        #ioStatus := 900;
        #oAlarmID := INT_TO_WORD(#wErrorID);
    ELSE
        #ioStatus := 0;
        #oAlarmID := 0;
    END_IF;
END_FUNCTION_BLOCK

