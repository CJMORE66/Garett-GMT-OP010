            // Transition to next step: 58
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_Glue_4;
            END_IF;

        // ===========================================
        // STEP 58: Glue_4
        // ===========================================
        STEP_ST10_Flow7_CGlueing_Glue_4:
            // No actions in XML

            // Transition to next step: 33
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_Glue_1;
            END_IF;

        // ===========================================
        // STEP 33: Glue_1
        // ===========================================
        STEP_ST10_Flow7_CGlueing_Glue_1:
            // No actions in XML

            // Transition to next step: 133
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_IV3Check_3;
            END_IF;

        // ===========================================
        // STEP 133: IV3Check_3
        // ===========================================
        STEP_ST10_Flow7_CGlueing_IV3Check_3:
            // Action Qualifier=N, Event="S1"
            // Token: "DB_KeyenceCheckerIV3".aDev[2].Common.nMode := 1
            "DB_KeyenceCheckerIV3".aDev[2].Common.nMode := 1;

            // Transition to next step: 66
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_Magnet_GlueCheck;
            END_IF;

        // ===========================================
        // STEP 66: Magnet_GlueCheck
        // ===========================================
        STEP_ST10_Flow7_CGlueing_Magnet_GlueCheck:
            // No actions in XML

            // Transition to next step: 8
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_WaitRobotInitialFinish;
            END_IF;

        // ===========================================
        // STEP 8: WaitRobotInitialFinish
        // ===========================================
        STEP_ST10_Flow7_CGlueing_WaitRobotInitialFinish:
            // No actions in XML

            // Transition to next step: 2
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_S2;
            END_IF;

        // ===========================================
        // STEP 2: S2
        // ===========================================
        STEP_ST10_Flow7_CGlueing_S2:
            // No actions in XML

            // Transition to next step: 29
            IF TRUE THEN  // Sequential transition - review XML for actual condition
                #State := STEP_ST10_Flow7_CGlueing_Axis_XToGluePos_1;
            END_IF;

        // ===========================================
        // STEP 29: Axis_XToGluePos_1
        // ===========================================
        STEP_ST10_Flow7_CGlueing_Axis_XToGluePos_1:
            // Action Qualifier=N
            // Token: "IAI_DeviceCtl".IAIServo[#X_Axis].Point[3].Start
            "IAI_DeviceCtl".IAIServo[#X_Axis].Point[3].Start;

    END_CASE;

    // UPDATE ioPM_Inface
    #ioPM_Inface.InitialRun := #act_InitialRun;
    #ioPM_Inface.InitialOK := #act_InitialOK;
    #ioPM_Inface.WaitRunning := #act_WaitRunning;
    #ioPM_Inface.Running := #act_Running;
    #ioPM_Inface.ProcessComplete := #act_ProcessComplete;
    #ioPM_Inface.ProcessStart := #act_ProcessStart;
    #ioPM_Inface.UnPause := #act_UnPause;

    // ERROR HANDLING
    IF #bError THEN
        #ioStatus := 900;
        #oAlarmID := INT_TO_WORD(#wErrorID);
    ELSE
        #ioStatus := 0;
        #oAlarmID := 0;
    END_IF;
END_FUNCTION_BLOCK

