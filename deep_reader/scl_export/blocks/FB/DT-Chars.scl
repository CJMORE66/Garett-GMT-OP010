  Month_Byte3 : String[1];
  Month_Byte4 : String[1];
  Days_Byte3 : String[1];
  Days_Byte4 : String[1];
  HH_Byte3 : String[1];
  HH_Byte4 : String[1];
  MM_Byte3 : String[1];
  MM_Byte4 : String[1];
  SS_Byte3 : String[1];
  SS_Byte4 : String[1];
  CalculateDays_Byte4 : String[1];
  CalculateDays_Byte5 : String[1];
  CalculateDays_Byte6 : String[1];
  OTimeStr : String[20];
END_VAR
VAR
  Sum_Days : Int;
  Sum_Year : Int;
