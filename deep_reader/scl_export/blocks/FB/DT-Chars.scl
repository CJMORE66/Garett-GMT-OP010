  Month_Byte1 : Char;
  Month_Byte2 : Char;
  Days_Byte1 : Char;
  Days_Byte2 : Char;
  HH_Byte1 : Char;
  HH_Byte2 : Char;
  MM_Byte1 : Char;
  MM_Byte2 : Char;
  SS_Byte1 : Char;
  SS_Byte2 : Char;
  CalculateDays_Byte1 : Char;
  CalculateDays_Byte2 : Char;
