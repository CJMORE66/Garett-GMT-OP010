FUNCTION_BLOCK "FB_Analog"
VAR_INPUT
  iSysInface : "RCS_SysComInterface_V1";
  "iunit in" : UInt;
  "iunit out" : UInt;
  "iHardware input" : Word;
  iRangeDown : Real;
  iRangeUp : Real;
END_VAR
VAR_IN_OUT
  io_Dev : "ST_GeneralAnalog";
END_VAR
VAR_TEMP
  TmpMidReal0 : Real;
END_VAR
BEGIN
  // Původní jazyk: LAD
  // Zdroj XML: EXPORT/Program blocks/03_Device/212 Analog/FB_Analog.xml
  // --- LAD/FBD → SCL (orientační převod, jen pro revizi) ---
  // Network 1
  #io_Dev.Common.bEnable := #iSysInface.SysRun;
  // Network 2
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(2)
  // Network 3
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(1)
  // Network 4
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Normalize(1), Scale_X(1)
  // Network 5
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Lt(1), Gt(1), Ge(1), Le(1)
  // Coil UId=33: nelze určit podmínku (vstupní síť).
  // Coil UId=35: nelze určit podmínku (vstupní síť).
  // Coil UId=38: nelze určit podmínku (vstupní síť).
END_FUNCTION_BLOCK
