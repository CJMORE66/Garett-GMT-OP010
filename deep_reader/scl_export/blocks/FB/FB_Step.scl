FUNCTION_BLOCK "FB_Step"
VAR_INPUT
  I_bRun : Bool;
END_VAR
VAR
  sCurrNo : UInt;
  sNextNo : UInt;
  sPls : Bool;
  sCondition : Bool;
  sRunJump : Bool;
  sTON : TON_TIME;
  sDealyTime : Time;
  sTempNo : UInt;
  bInitialization : Bool;
END_VAR
BEGIN
  // Původní jazyk: LAD
  // Zdroj XML: EXPORT/Program blocks/03_Device/999 Base/FB_Step.xml
  // --- LAD/FBD → SCL (orientační převod, jen pro revizi) ---
  // Network 1
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(1)
  // Network 2
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(2), Eq(1), TON(1), O(1)
  // RCoil UId=44: nelze určit podmínku (vstupní síť).
  // RCoil UId=45: nelze určit podmínku (vstupní síť).
  // Network 3
  IF TRUE THEN #bInitialization := FALSE; END_IF;
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(2), Ne(1), Eq(1)
  // Coil UId=32: nelze určit podmínku (vstupní síť).
END_FUNCTION_BLOCK
