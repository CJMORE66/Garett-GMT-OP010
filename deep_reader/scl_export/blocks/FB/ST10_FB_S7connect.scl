FUNCTION_BLOCK "ST10_FB_S7connect"
VAR_INPUT
  "CLOCK_0.2_SEC" : Bool;
END_VAR
VAR
  Always_On : Bool;
  Status_Get : Array[1..6] of Struct;
  Status_Put : Array[1..6] of Struct;
  GET_Instance1 : GET;
  GET_Instance2 : GET;
  PUT_Instance1 : PUT;
  PUT_Instance2 : PUT;
  PLs : Array[1..6] of Bool;
  TON : Array[1..5] of TON_TIME;
  NextStation_OffLine : Bool;
END_VAR
BEGIN
  // Původní jazyk: LAD
  // Zdroj XML: EXPORT/Program blocks/OP010/10_Device/09_CuringOven/ST10_FB_S7connect.xml
  // --- LAD/FBD → SCL (orientační převod, jen pro revizi) ---
  // Network 1
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): PUT(1)
  // Network 2
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): GET(1)
  // Network 3
  ST10_PLC_PutDB.OutData.Global.Beat := (AlwaysTRUE AND ClockMemory0.5s);
  // Network 4
  ST10_PLC_PutDB.OutData.Global.AutoRunning := (AlwaysTRUE AND Station_Sys.Auto.Mode);
  // Network 5
  ST10_PLC_PutDB.OutData.Global.Spare_1 := Station_Sys.Status.EStopOK;
  // Network 6
  AutoProcessControl.Headt.PalletUnloadingPrimit := (AlwaysTRUE AND ST10_PLC_GetDB.InData.Control.AskPallet);
END_FUNCTION_BLOCK
