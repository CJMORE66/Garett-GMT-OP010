FUNCTION_BLOCK "MaterialGate"
VAR_INPUT
  iSysInface : "RCS_SysComInterface_V1";
  "iMaterialGate Opened Monitor" : Bool;
  "iMaterialGate Locked Monitor" : Bool;
  i1s_Pulse : Bool;
  "iMaterialGate AutoLock Timer" : Time;
  "iMaterialGate ManualLock Timer" : Time;
END_VAR
VAR_OUTPUT
  "oMaterialGate LockedLamp" : Bool;
END_VAR
VAR_IN_OUT
  ioMaterialGateLock : Bool;
  ioHMI_Interface : "SafetyGateUDT";
END_VAR
VAR
  "sMaterialafetyGate Timer" : Array[1..5] of TON_TIME;
  sP_Trig : Array[1..10] of Bool;
  sN_Trig : Array[1..10] of Bool;
  "sMaterialGate UnlockRequest" : Bool;
  "sMaterialGate LockRequest" : Bool;
END_VAR
VAR_TEMP
  tAlyways_On : Bool;
  tAlyways_Off : Bool;
END_VAR
BEGIN
  // Původní jazyk: LAD
  // Zdroj XML: EXPORT/Program blocks/03_Device/102 SafetyGate/MaterialGate.xml
  // --- LAD/FBD → SCL (orientační převod, jen pro revizi) ---
  // Network 1
  IF NOT #tAlyways_On THEN #tAlyways_On := TRUE; END_IF;
  // Network 2
  IF #tAlyways_On THEN #tAlyways_Off := FALSE; END_IF;
  // Network 3
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): O(1), PBox(1)
  // SCoil UId=40: nelze určit podmínku (vstupní síť).
  // RCoil UId=41: nelze určit podmínku (vstupní síť).
  // SCoil UId=44: nelze určit podmínku (vstupní síť).
  // RCoil UId=45: nelze určit podmínku (vstupní síť).
  // Network 4
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): PBox(3), NBox(1)
  // RCoil UId=37: nelze určit podmínku (vstupní síť).
  // RCoil UId=40: nelze určit podmínku (vstupní síť).
  // RCoil UId=41: nelze určit podmínku (vstupní síť).
  // RCoil UId=44: nelze určit podmínku (vstupní síť).
  // RCoil UId=46: nelze určit podmínku (vstupní síť).
  // Network 5
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): O(1)
  // RCoil UId=31: nelze určit podmínku (vstupní síť).
  // Network 6
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): TON(3), O(2)
  // SCoil UId=55: nelze určit podmínku (vstupní síť).
  // Network 7
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): O(1)
  // Coil UId=31: nelze určit podmínku (vstupní síť).
  // Network 8
  #ioHMI_Interface.Status.Lock/Unlock Indicator := #ioMaterialGateLock;
  // Network 9
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(3)
  // Coil UId=39: nelze určit podmínku (vstupní síť).
  // Coil UId=43: nelze určit podmínku (vstupní síť).
  // Coil UId=47: nelze určit podmínku (vstupní síť).
END_FUNCTION_BLOCK
