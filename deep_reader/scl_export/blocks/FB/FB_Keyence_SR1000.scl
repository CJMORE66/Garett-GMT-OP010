                  .#FB_Step.sNextNo := ;
              :
                  
                  .#FB_Step.sDealyTime := ;
                  
                  .#FB_Step.sCondition :=( ..#IO_udtData.In.bReadComplete AND NOT ..#IO_udtData.In.bBusy ) OR [].;
                  IF .#FB_Step.sCondition THEN
