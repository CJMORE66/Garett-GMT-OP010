                  END_IF;
                  .#FB_Step.sNextNo := ;
              :
                  IF .#IO_udtData.RecordCode =  THEN
                      ..#IO_udtData.Common.bNG := ;
                      ..#IO_udtData.Common.bOK := ;
                  ELSE
                      ..#IO_udtData.Common.bNG := ;
                      ..#IO_udtData.Common.bOK := ;
                  END_IF;
                  .#FB_Step.sCondition := ;
                  .#FB_Step.sNextNo := ;
              :
                  IF .#FB_Step.sPls THEN
                      ..#IO_udtData.Out.bReadComlpleteClear := ;
                  END_IF;
                  .#FB_Step.sCondition := NOT ..#IO_udtData.In.bReadComplete AND NOT ..#IO_udtData.In.bReadFailure;
                  .#FB_Step.sNextNo := ;
              :
                  IF .#FB_Step.sPls THEN
                      ..#IO_udtData.Out.bReadComlpleteClear := ;
