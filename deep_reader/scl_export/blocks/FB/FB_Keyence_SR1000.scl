  END_REGION
  REGION 
      
      
      
      ..#IO_udtData.In.bBusy := ..%X1#sPN_IN.BUSYStatusBits;
      ..#IO_udtData.In.bError := ..%X0#sPN_IN.Handshake;
      ..#IO_udtData.In.bReadComplete := ..%X0#sPN_IN.CompletionStatus;
      ..#IO_udtData.In.bReadFailure := ..%X0#sPN_IN.ErrorStatusBits;
