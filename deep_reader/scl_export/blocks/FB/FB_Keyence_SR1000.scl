      IF []. THEN
          ..#IO_udtData.Common.nErrorNo := ;
          .%X0#io_nError := ;
      END_IF;
      
      
      
      []( := NOT .#FB_Step.sCondition AND .#FB_Step.sNextNo = ,
               := );
      
      
      
      IF ..#IO_udtData.Common.nErrorNo <>  THEN
          ..#IO_udtData.Common.bError := ;
          ..#IO_udtData.Common.nMode := ;
      END_IF;
      
      
      IF ..#IO_udtData.Common.bReset AND ..#IO_udtData.Common.bError THEN
          ..#IO_udtData.Common.nErrorNo := ;
          #io_nError := ;
          ..#IO_udtData.Common.bError := ;
      END_IF;
      
      ..#IO_udtData.Out.bErrorClear := ..#IO_udtData.Common.bReset;
      
  END_REGION
  REGION 
      
      ..#IO_udtData.Common.nWarningNo := ..#IO_udtData.In.nReadResultCode;
  END_REGION
  REGION 
      IF ..#IO_udtData.In.bReadComplete THEN
          ..#IO_udtData.In.nDataSize := .[] - ;
