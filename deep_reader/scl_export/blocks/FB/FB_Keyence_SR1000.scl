      END_IF;
  END_REGION
  REGION 
      ();
      IF ..#IO_udtData.Common.nMode <>  THEN
          CASE .#FB_Step.sCurrNo OF
              :
                  .#FB_Step.sCondition := ..#IO_udtData.Common.nMode = ;
