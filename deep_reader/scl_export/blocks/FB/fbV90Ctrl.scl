  #sCMMT.ConfigEPos := #tNormalON;
  #sCMMT.ConfigEPos := (#tNormalON AND #iLimitSoftActive);
  #sCMMT.ConfigEPos := (#tNormalON AND #iLimitSwitchActive);
  #tCancelTask := (((#tNormalON AND #iSysRun) AND #iEstop) AND #iInterlock);
