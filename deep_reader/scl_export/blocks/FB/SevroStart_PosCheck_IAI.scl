FUNCTION_BLOCK "SevroStart&PosCheck_IAI"
VAR_INPUT
  iRef_Homed : Bool;
  iStandstill : Bool;
  iReset : Bool;
  interlcok : Bool;
  "iActual Posi" : Real;
  "iTol+" : Real;
  "iTol-" : Real;
  iStartTon : Time;
END_VAR
VAR_OUTPUT
  oStartPos : Bool;
  DoublePosError : Bool;
END_VAR
VAR_IN_OUT
  ioPoint : Array[0..39] of Struct;
  ioList : "PosList_IAI";
  ioPosNumberSelect : Int;
END_VAR
VAR
  TON : Array[0..1] of TON_TIME;
  StartCount : Int;
END_VAR
VAR_TEMP
  "Actual Posi+Tol" : Real;
  "Actual Posi-Tol" : Real;
  Index : Array[0..7] of Int;
  PosStart : Bool;
END_VAR
BEGIN
  // Původní jazyk: LAD
  // Zdroj XML: EXPORT/Program blocks/OP010/10_Device/22_IAI/ServoCheck/SevroStart&PosCheck_IAI.xml
  // --- Rekonstruovaný StructuredText (best-effort) ---
  // Network 1
  [] := ;
  #PosStart := ;
  FOR [] :=  TO  DO
      IF [[]]. THEN
          
          #ioPosNumberSelect := [];
          #PosStart := ;
          EXIT;
      END_IF;
  END_FOR;
  [] := ;
  #StartCount := ;
  FOR [] :=  TO  DO
      IF [[]]. THEN
          
          #StartCount := #StartCount+;
        
          
      END_IF;
      IF [] =  THEN
          
          EXIT;
      END_IF;
          
  END_FOR;
  // Network 2
  [] := ;
  FOR [] :=  TO  DO
      IF .[ []].>= #Actual Posi-Tol
          AND .[ []].<= #Actual Posi+Tol
      THEN
        [[]]. := ;
      ELSE
          [[]]. := ;
      END_IF;
  END_FOR;
  // --- LAD/FBD → SCL (orientační převod, jen pro revizi) ---
  // Network 1
  IF #iReset THEN #DoublePosError := FALSE; END_IF;
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Eq(1), TON(1), Gt(1)
  // Coil UId=39: nelze určit podmínku (vstupní síť).
  // SCoil UId=41: nelze určit podmínku (vstupní síť).
  // Network 2
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Add(1), Sub(1)
END_FUNCTION_BLOCK
