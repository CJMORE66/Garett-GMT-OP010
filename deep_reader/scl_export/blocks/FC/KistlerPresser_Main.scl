  ProcessData_1.PressInterlock_2 := ((Station_Sys.Status.Run AND Station_Sys.Status.EStopOK) AND KukaRobot2_CtrlDB.sROBtoPLC.User.Home.DO180_PressPutArea);
  ProcessData_1.PressInterlock_2 := ((Station_Sys.Status.Run AND Station_Sys.Status.EStopOK) AND KukaRobot3_CtrlDB.sROBtoPLC.User.Home.DO177_PressPut1Area);
  ProcessData_1.PressInterlock_2 := (Station_Sys.Status.Run AND Station_Sys.Status.EStopOK);
  ProcessData_1.PressInterlock_2 := (Station_Sys.Status.Run AND Station_Sys.Status.EStopOK);
  ProcessData_1.OP40.3.Kistler_Interlock := ((((((Station_Sys.Status.Run AND Station_Sys.Status.EStopOK) AND ProcessData_1.PressInterlock_2) AND ProcessData_1.PressInterlock_2) AND ProcessData_1.PressInterlock_2) AND ProcessData_1.PressInterlock_2) AND ProcessData_1.PressInterlock_2);
  // --- Poznámky / omezení převodu ---
