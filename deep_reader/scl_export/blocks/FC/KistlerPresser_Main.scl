  // Network 1
  (:=.KistlerPresser1_DB.Shaft,
                :=,
                =>#tRel,
                :=.KistlerPresser1_DB.ShaftID);
  // Network 2
  (:=.KistlerPresser2_DB.Shaft,
                :=,
