  ProcessData_1.PressInterlock_1 := ((Station_Sys.Status.Run AND Station_Sys.Status.EStopOK) AND KukaRobot1_CtrlDB.sROBtoPLC.User.Home.DO178_PressPut2Area);
  ProcessData_1.PressInterlock_1 := (Station_Sys.Status.Run AND Station_Sys.Status.EStopOK);
  ProcessData_1.PressInterlock_1 := (Station_Sys.Status.Run AND Station_Sys.Status.EStopOK);
  ProcessData_1.OP40.2.Kistler_Interlock := ((((((Station_Sys.Status.Run AND Station_Sys.Status.EStopOK) AND ProcessData_1.PressInterlock_1) AND ProcessData_1.PressInterlock_1) AND ProcessData_1.PressInterlock_1) AND ProcessData_1.PressInterlock_1) AND ProcessData_1.PressInterlock_1);
