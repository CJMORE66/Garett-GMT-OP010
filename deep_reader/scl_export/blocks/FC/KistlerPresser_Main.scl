  // Network 13
  IF NOT Station_Sys.Status.Run THEN DB_maXYmosNC1.StartCycle := FALSE; END_IF;
  // --- Poznámky / omezení převodu ---
  // RCoil UId=27: nelze určit podmínku (vstupní síť).
  // RCoil UId=28: nelze určit podmínku (vstupní síť).
  // Network 14
  IF (Station_Sys.Status.Run AND NOT Station_Sys.Manual.Mode) THEN ProcessData_1.Calibartion_2 := FALSE; END_IF;
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(6), Eq(3), Ne(3), Le(1), O(1)
