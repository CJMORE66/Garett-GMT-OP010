  // Network 6
  IF (Station_Sys.Status.Run AND NOT Station_Sys.Manual.Mode) THEN ProcessData_1.Calibartion_1 := FALSE; END_IF;
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): Move(6), Eq(3), Ne(3), Le(1), O(1)
  // Network 7
  ProcessData_1.OP40.2.Kistler_Continue_Interlock := Sys.COM.AlwaysON;
  // Network 8
  // --- Poznámky / omezení převodu ---
