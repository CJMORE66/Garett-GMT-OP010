FUNCTION "ST10_ChangeOver" : Void
VAR_TEMP
  sString : String[50];
  FixtureNumber : Int;
  FixtureIndex : Int;
  tRET_VAL : Int;
END_VAR
BEGIN
  // Původní jazyk: LAD
  // Zdroj XML: EXPORT/Program blocks/OP010/08_ChangeOver/ST10_ChangeOver.xml
  // --- Rekonstruovaný StructuredText (best-effort) ---
  // Network 1
  .[]. := ;
  
  .[]..%X0 := ;
  .[]..%X1 := ;
  .[]..%X2 := ;
  .[]..%X3 := ;
  .[]..%X4 := ;
  .[]..%X5 := ;
  .[]..%X6 := ;
  .[]..%X7 := ;
  // Network 2
  #FixtureNumber := ;
  
  #FixtureIndex := ;
  FOR #FixtureIndex :=  TO #FixtureNumber DO
     
      ( := ..[#FixtureIndex],
                        := .[#FixtureIndex]);
      
  END_FOR;
  // --- LAD/FBD → SCL (orientační převod, jen pro revizi) ---
  // Network 1
  Station_Sys.Cmd.OnOffLine := ST10_GeneralData.FunctionDeSelect.MES.FunctionDeSelected;
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): O(1), BLKMOV(1)
  // Network 2
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): S_Move(2)
  // Network 3
  // --- Poznámky / omezení převodu ---
