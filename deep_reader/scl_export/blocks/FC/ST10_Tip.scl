  // Coil UId=37: nelze určit podmínku (vstupní síť).
  // Network 9
  ST10_TipDB.Global.6 := (((AlwaysTRUE AND Station_Sys.Auto.Mode) AND NOT AutoProcessControl.J_MagnetLine.Robot2PickPrimit) AND NOT iJ-magnetLiftingPalletDischargeDetection);
