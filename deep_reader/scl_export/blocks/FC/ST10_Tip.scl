  // Coil UId=37: nelze určit podmínku (vstupní síť).
  // Network 10
  ST10_TipDB.Global.6 := (((AlwaysTRUE AND Station_Sys.Auto.Mode) AND NOT AlwaysTRUE) AND NOT AlwaysTRUE);
  // --- Poznámky / omezení převodu ---
  // Síť obsahuje nepodporované prvky (ponecháno jen jako komentář): TON(1)
  // Coil UId=39: nelze určit podmínku (vstupní síť).
  // Network 11
  ST10_TipDB.Global.6 := (((AlwaysTRUE AND Station_Sys.Auto.Mode) AND NOT AutoProcessControl.L_ShafeLine.Robot3PutPrimit) AND AutoProcessControl.Global.L.LoadStopRequestPallet_3);
